---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getAlternates, getSite, DEFAULT_LOCALE } from '../lib/content.js';

const { locale, sectionKey, content } = Astro.props;
const site = getSite(locale);
const alternates = getAlternates(sectionKey);
const canonical = new URL(Astro.url.pathname, Astro.site);
const gaId = import.meta.env.PUBLIC_GA_ID; // set at alpha stage; absent = no GA
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{content.metaTitle}</title>
    <meta name="description" content={content.metaDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map(({ locale: l, href }) => (
      <link rel="alternate" hreflang={l} href={new URL(href, Astro.site)} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternates.find((a) => a.locale === DEFAULT_LOCALE).href, Astro.site)}
    />
    {gaId && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    )}
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}
  </head>
  <body>
    <Header locale={locale} sectionKey={sectionKey} site={site} />
    <main>
      <slot />
    </main>
    <Footer site={site} />
  </body>
</html>
