---
// Decorative marble veining echoing the logo's stone texture.
// Two clusters only — top-left and bottom-right — instead of a full-page
// pattern: the texture should read as an accent, not as wallpaper.
// Inline SVG (no extra request), inert to pointer events, behind all content.
---
<div class="veins" aria-hidden="true">
  <svg class="veins-tl" viewBox="0 0 420 420" fill="none" preserveAspectRatio="xMinYMin slice">
    <g stroke="currentColor" stroke-linecap="round" fill="none">
      <path d="M-20 46 C 62 72, 112 96, 152 146 S 206 236, 242 306 S 278 376, 302 428"
            stroke-width="1.5" opacity=".85" />
      <path d="M152 146 C 178 156, 204 150, 236 124 S 286 82, 330 70"
            stroke-width="1.1" opacity=".6" />
      <path d="M242 306 C 264 298, 288 302, 310 288"
            stroke-width=".9" opacity=".5" />
      <path d="M-20 124 C 52 146, 98 168, 134 212 S 174 278, 190 338"
            stroke-width=".8" opacity=".45" />
      <path d="M64 -14 C 84 42, 98 74, 132 104"
            stroke-width=".7" opacity=".4" />
      <path d="M134 212 C 112 232, 96 258, 88 292"
            stroke-width=".6" opacity=".35" />
      <path d="M236 124 C 248 100, 254 76, 250 48"
            stroke-width=".55" opacity=".3" />
      <path d="M-20 210 C 34 224, 62 244, 80 272"
            stroke-width=".5" opacity=".28" />
    </g>
  </svg>

  <svg class="veins-br" viewBox="0 0 420 420" fill="none" preserveAspectRatio="xMaxYMax slice">
    <g stroke="currentColor" stroke-linecap="round" fill="none">
      <path d="M440 374 C 358 348, 308 324, 268 274 S 214 184, 178 114 S 142 44, 118 -8"
            stroke-width="1.5" opacity=".85" />
      <path d="M268 274 C 242 264, 216 270, 184 296 S 134 338, 90 350"
            stroke-width="1.1" opacity=".6" />
      <path d="M178 114 C 156 122, 132 118, 110 132"
            stroke-width=".9" opacity=".5" />
      <path d="M440 296 C 368 274, 322 252, 286 208 S 246 142, 230 82"
            stroke-width=".8" opacity=".45" />
      <path d="M356 434 C 336 378, 322 346, 288 316"
            stroke-width=".7" opacity=".4" />
      <path d="M286 208 C 308 188, 324 162, 332 128"
            stroke-width=".6" opacity=".35" />
      <path d="M184 296 C 172 320, 166 344, 170 372"
            stroke-width=".55" opacity=".3" />
      <path d="M440 210 C 386 196, 358 176, 340 148"
            stroke-width=".5" opacity=".28" />
    </g>
  </svg>
</div>
