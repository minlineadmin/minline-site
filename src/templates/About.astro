---
const { content } = Astro.props;
---
<section class="section">
  <div class="container">
    <h1>{content.intro.title}</h1>
    <div class="section-intro">
      <p>{content.intro.lead}</p>
    </div>
    {content.blocks.map((block) => (
      <div class="section-intro">
        <h2>{block.title}</h2>
        <p>{block.text}</p>
      </div>
    ))}
  </div>
</section>
