---
import { pagePath } from '../lib/content.js';

const { locale, content } = Astro.props;
const contactsPath = pagePath(locale, 'contacts');
---
<section class="section section-lead">
  <div class="container">
    <h1>{content.intro.title}</h1>
    <div class="section-intro">
      {content.intro.paragraphs.map((p) => <p class="lead">{p}</p>)}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>{content.advantages.title}</h2>
    <ul class="feature-list">
      {content.advantages.items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>{content.cta.title}</h2>
    <div class="section-intro">
      <p>{content.cta.text}</p>
    </div>
    <a class="btn btn-primary" href={contactsPath}>{content.cta.button}</a>
  </div>
</section>
