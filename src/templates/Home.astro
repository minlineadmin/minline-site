---
import { pagePath } from '../lib/content.js';
import DirectionIcon from '../components/DirectionIcon.astro';

const { locale, content } = Astro.props;
const contactsPath = pagePath(locale, 'contacts');
const directionsPath = {
  smartfield: pagePath(locale, 'smartfield'),
  pumps: pagePath(locale, 'pumps')
};
---
<section class="hero">
  <div class="container">
    <h1>{content.hero.title}</h1>
    <p class="lead">{content.hero.lead}</p>
    <div class="actions">
      <a class="btn btn-primary" href="#directions">{content.hero.ctaPrimary}</a>
      <a class="btn btn-ghost" href={contactsPath}>{content.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<section class="section" id="directions">
  <div class="container">
    <h2>{content.directions.title}</h2>
    <div class="section-intro">
      <p>{content.directions.lead}</p>
    </div>
    <div class="grid grid-2">
      {content.directions.items.map((item) => (
        <a class="card card-link" href={directionsPath[item.key]}>
          <DirectionIcon name={item.key} />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <span class="card-more">{item.more}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>{content.advantages.title}</h2>
    <ul class="feature-list">
      {content.advantages.items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>{content.cta.title}</h2>
    <div class="section-intro">
      <p>{content.cta.text}</p>
    </div>
    <a class="btn btn-primary" href={contactsPath}>{content.cta.button}</a>
  </div>
</section>
