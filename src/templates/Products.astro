---
const { content } = Astro.props;
---
<section class="section">
  <div class="container">
    <h1>{content.intro.title}</h1>
    <div class="section-intro">
      <p>{content.intro.lead}</p>
    </div>
    <div class="grid">
      {content.categories.map((item) => (
        <div class="card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
